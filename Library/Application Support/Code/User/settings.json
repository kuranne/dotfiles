{
  "breadcrumbs.enabled": false,

  "chat.agentsControl.enabled": "hidden",
  "chat.mcp.gallery.enabled": true,
  "chat.titleBar.openInAgentsWindow.enabled": false,

  "custom-ui-style.electron": {
    "titleBarStyle": "hiddenInset",
    "trafficLightPosition": {
      "x": -100,
      "y": -100,
    },
  },
  "custom-ui-style.stylesheet": {
    ".notification-toast": "box-shadow: none !important",
    ".quick-input-widget.show-file-icons": "box-shadow: none !important",
    ".quick-input-widget": "top: 25vh !important",
    ".quick-input-list .scrollbar": "display: none",
    ".monaco-action-bar.quick-input-inline-action-bar": "display: none",
    ".editor-widget.find-widget": "box-shadow: none; border-radius: 4px",
    ".quick-input-titlebar": "background: #100B15 !important",
    ".monaco-workbench .part.editor > .content .editor-group-container > .title.title-border-bottom:after": "display: none",
    ".monaco-scrollable-element > .shadow.top": "display: none",
    ".sidebar .title-label": "padding: 0 !important",
    ".sidebar": "border: none !important",
    ".monaco-workbench .monaco-list:not(.element-focused):focus:before": "outline: none !important",
    ".monaco-list-row.focused": "outline: none !important",
    ".monaco-editor .scroll-decoration": "display: none",
    ".title-actions": "display: none !important",
    ".title.show-file-icons .label-container .monaco-icon-label.file-icon": "justify-content: center; padding: 0 !important",
    ".title .monaco-icon-label:after": "margin-right: 0",
    ".monaco-workbench .part.editor > .content .editor-group-container > .title > .label-container > .title-label": "padding-left: 60px",
    ".title .monaco-icon-label.file-icon": "margin: 0 60px",
    ".monaco-editor .cursors-layer .cursor": "background-image: linear-gradient(135deg, #ffaffc 10%, #DA70D6 100%)",
  },

  "docker.extension.enableComposeLanguageServer": false,

  "editor.accessibilitySupport": "off",
  "editor.codeLensFontFamily": "'JetbrainsMono Nerd Font'",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontSize": 12,
  "editor.fontFamily": "'JetBrainsMono Nerd Font'",
  "editor.formatOnSave": true,
  "editor.inertialScroll": true,
  "editor.inlineSuggest.enabled": false,
  "editor.largeFileOptimizations": false,
  "editor.smoothScrolling": true,
  "editor.wordWrap": "on",
  "editor.mouseWheelZoom": true,
  "editor.formatOnPaste": true,
  "editor.codeLens": true,
  "editor.lineHeight": 1.6,
  "editor.fontLigatures": true,
  "editor.renderLineHighlight": "gutter",
  "editor.occurrencesHighlight": "off",
  "editor.hideCursorInOverviewRuler": true,
  "editor.lightbulb.enabled": "off",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "smooth",

  "errorLens.enabledDiagnosticLevels": ["info", "warning", "error"],
  "errorLens.fontFamily": "JetBrainsMono Nerd Font",

  "extensions.ignoreRecommendations": true,

  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.enableDragAndDrop": true,
  "explorer.autoOpenDroppedFile": false,
  "explorer.fileNesting.enabled": true,
  "explorer.compactFolders": true,

  "git.openRepositoryInParentFolders": "always",

  "kotlin.languageServer.enabled": false,
  "kotlin.debugAdapter.enabled": false,

  "redhat.telemetry.enabled": false,

  "terminal.integrated.fontFamily": "\"JetBrainsMonoNL Nerd Font\"",
  "terminal.integrated.gpuAcceleration": "on",

  "window.autoDetectColorScheme": false,
  "window.commandCenter": false,
  "window.confirmBeforeClose": "never",
  "window.systemColorTheme": "dark",
  "window.titleBarStyle": "native",
  "window.customTitleBarVisibility": "never",
  "window.zoomLevel": 1.5,

  "workbench.browser.showInTitleBar": false,
  "workbench.colorTheme": "Eva Dark",
  "workbench.editor.showTabs": "single",
  "workbench.experimental.share.enabled": true,
  "workbench.fontAliasing": "antialiased",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.layoutControl.enabled": false,
  "workbench.navigationControl.enabled": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.startupEditor": "none",
  "workbench.statusBar.visible": true,
  "workbench.activityBar.autoHide": true,
  "workbench.editor.decorations.badges": false,

  "workbench.colorCustomizations": {
    "activityBar.background": "#1e1e1e4d",
    "breadcrumb.background": "#1e1e1e00",
    "editor.background": "#1e1e1e4d",
    "editorGutter.background": "#1e1e1e00",
    "editorGroupHeader.noTabsBackground": "#1e1e1e00",
    "editorGroupHeader.tabsBackground": "#1e1e1e00",
    "editorHoverWidget.background": "#1e1e1ee6",
    "editorPane.background": "#1e1e1e00",
    "editorStickyScroll.background": "#1e1e1e4d",
    "editorStickyScrollGutter.background": "#1e1e1e4d",
    "editorSuggestWidget.background": "#1e1e1ee6",
    "editorWidget.background": "#1e1e1ee6",
    "inlineChat.background": "#1e1e1ee6",
    "menu.background": "#1e1e1ee6",
    "notificationCenterHeader.background": "#1e1e1ee6",
    "notifications.background": "#1e1e1ee6",
    "panel.background": "#1e1e1e00",
    "panelStickyScroll.background": "#1e1e1e00",
    "quickInput.background": "#1e1e1ee6",
    "sideBar.background": "#1e1e1e4d",
    "sideBarStickyScroll.background": "#1e1e1e4d",
    "sideBarTitle.background": "#1e1e1e4d",
    "tab.activeBackground": "#1e1e1e00",
    "tab.inactiveBackground": "#1e1e1e4d",
    "tab.unfocusedActiveBackground": "#1e1e1e00",
    "tab.unfocusedInactiveBackground": "#1e1e1e4d",
    "terminal.background": "#00000000",
  },

  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
  },
  "git.confirmSync": false,
  "security.workspace.trust.startupPrompt": "once",
  "workbench.activityBar.location": "bottom",
  "editor.minimap.enabled": false,
}
