local CURRENT_DIR="${PWD:t}"
local TITLE="  $CURRENT_DIR"
local BRANCH=""

# Fast guard: only query git if inside a git worktree
if [[ -e .git ]] || git rev-parse --is-inside-work-tree &>/dev/null; then
    BRANCH=$(git branch --show-current 2>/dev/null)
    [[ -n "$BRANCH" ]] && TITLE="$TITLE   $BRANCH"
fi

printf "\033]0;%s\007" "$TITLE"
