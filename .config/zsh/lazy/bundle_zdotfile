bundle_zdotfile() {
    setopt localoptions extendedglob nullglob numericglobsort

    local opt_root=""
    local opt_out=""
    local opt_compile=0
    local opt_strict=0
    local opt_verbose=0
    local -a positional=()

    while (( $# )); do
        case "$1" in
            --help|-h)
                print -u2 "Usage: bundle_zdotfile [options] [target_dir | input_files...]"
                print -u2 ""
                print -u2 "Options:"
                print -u2 "  --root <dir>          Root boundary for inlining (auto-detected if omitted)"
                print -u2 "  -o, --output <path>   Output file or target bundle directory"
                print -u2 "  -c, --compile         Compile generated bundles with zcompile"
                print -u2 "  --strict              Fail on unresolvable dynamic sources"
                print -u2 "  -v, --verbose         Verbose progress logging"
                print -u2 "  -h, --help            Show this help message"
                return 0
                ;;
            --root)
                shift
                opt_root="${1:A}"
                ;;
            --root=*)
                opt_root="${${1#--root=}:A}"
                ;;
            -o|--output)
                shift
                opt_out="$1"
                ;;
            --output=*)
                opt_out="${1#--output=}"
                ;;
            -c|--compile)
                opt_compile=1
                ;;
            --strict)
                opt_strict=1
                ;;
            -v|--verbose)
                opt_verbose=1
                ;;
            --)
                shift
                positional+=( "$@" )
                break
                ;;
            -*)
                print -u2 "bundle_zdotfile: error: unknown option: $1"
                return 2
                ;;
            *)
                positional+=( "$1" )
                ;;
        esac
        shift
    done

    # -------------------------------------------------------------------------
    # Helper Functions (Pure Zsh, Zero eval)
    # -------------------------------------------------------------------------

    typeset -ga STACK=()
    typeset -gA LOOP_VARS=()
    typeset -ga TRANSCRIPT_MANIFEST=()

    _warn()  { print -u2 -- "bundle_zdotfile: warning: $*"; }
    _error() { print -u2 -- "bundle_zdotfile: error: $*"; }

    # Detect project / configuration root from a reference file
    _detect_root() {
        local f="${1:A}"
        local d="${f:h}"
        while [[ -n "$d" && "$d" != "/" && "$d" != "$HOME" ]]; do
            if [[ -d "$d/conf.d" || -f "$d/.zshrc" || -f "$d/.zshenv" || -d "$d/.git" ]]; then
                print -r -- "$d"
                return 0
            fi
            d="${d:h}"
        done
        print -r -- "${f:h}"
    }

    _strip_quotes() {
        local s="$1"
        s="${s##[[:space:]]#}"
        s="${s%%[[:space:]]#}"
        s="${s//\"/}"
        s="${s//\'/}"
        print -r -- "$s"
    }

    # Safe variable resolution: handles known parameters and loop variables without eval
    _resolve_vars() {
        local _res_s="$1" _res_root="$2" _res_name _res_val _res_tok
        local -i _res_iter=0

        [[ "$_res_s" != *'$('* && "$_res_s" != *'`'* ]] || return 2

        # Replace ${ZDOTDIR} / $ZDOTDIR
        if [[ -n "$_res_root" ]]; then
            _res_s="${_res_s//\$\{ZDOTDIR\}/$_res_root}"
            _res_s="${_res_s//\$ZDOTDIR/$_res_root}"
        fi

        while [[ "$_res_s" =~ '\$\{([A-Za-z_][A-Za-z0-9_]*)\}' ]]; do
            (( _res_iter++ > 15 )) && return 2
            _res_tok="$MATCH"
            _res_name="${match[1]}"
            if (( ${+LOOP_VARS[$_res_name]} )); then
                _res_val="${LOOP_VARS[$_res_name]}"
            elif [[ "$_res_name" == "ZDOTDIR" && -n "$_res_root" ]]; then
                _res_val="$_res_root"
            elif [[ "$_res_name" == "HOME" ]]; then
                _res_val="$HOME"
            elif [[ "$_res_name" == "MY_TERM" ]]; then
                return 2
            elif (( ${+parameters[$_res_name]} )) && [[ "$_res_name" != _res_* && "$_res_name" != s && "$_res_name" != f && "$_res_name" != line && "$_res_name" != script ]]; then
                _res_val="${(P)_res_name}"
            else
                return 2
            fi
            [[ "$_res_tok" != "$_res_val" ]] || return 2
            _res_s="${_res_s//$_res_tok/$_res_val}"
        done

        _res_iter=0
        while [[ "$_res_s" =~ '\$([A-Za-z_][A-Za-z0-9_]*)' ]]; do
            (( _res_iter++ > 15 )) && return 2
            _res_tok="$MATCH"
            _res_name="${match[1]}"
            if (( ${+LOOP_VARS[$_res_name]} )); then
                _res_val="${LOOP_VARS[$_res_name]}"
            elif [[ "$_res_name" == "ZDOTDIR" && -n "$_res_root" ]]; then
                _res_val="$_res_root"
            elif [[ "$_res_name" == "HOME" ]]; then
                _res_val="$HOME"
            elif [[ "$_res_name" == "MY_TERM" ]]; then
                return 2
            elif (( ${+parameters[$_res_name]} )) && [[ "$_res_name" != _res_* && "$_res_name" != s && "$_res_name" != f && "$_res_name" != line && "$_res_name" != script ]]; then
                _res_val="${(P)_res_name}"
            else
                return 2
            fi
            [[ "$_res_tok" != "$_res_val" ]] || return 2
            _res_s="${_res_s//$_res_tok/$_res_val}"
        done

        # Expand tilde
        if [[ "$_res_s" == '~' ]]; then
            _res_s="$HOME"
        elif [[ "$_res_s" == '~/'* ]]; then
            _res_s="$HOME/${_res_s#~/}"
        fi

        print -r -- "$_res_s"
    }

    # Pure recursive brace expansion without eval
    _brace_expand() {
        local s="$1"
        local i ch depth=0 start=0 end=0
        for (( i=1; i<=${#s}; i++ )); do
            ch="${s[i]}"
            if [[ "$ch" == "{" ]]; then
                (( depth++ ))
                (( depth == 1 )) && start=$i
            elif [[ "$ch" == "}" ]] && (( depth > 0 )); then
                (( depth-- ))
                if (( depth == 0 )); then
                    end=$i
                    break
                fi
            fi
        done

        if (( start == 0 || end == 0 )); then
            print -r -- "$s"
            return
        fi

        local prefix="${s[1,start-1]}"
        local suffix="${s[end+1,-1]}"
        local inner="${s[start+1,end-1]}"

        local -a parts=()
        local current=""
        depth=0
        for (( i=1; i<=${#inner}; i++ )); do
            ch="${inner[i]}"
            if [[ "$ch" == "{" ]]; then
                (( depth++ ))
                current+="$ch"
            elif [[ "$ch" == "}" ]] && (( depth > 0 )); then
                (( depth-- ))
                current+="$ch"
            elif [[ "$ch" == "," ]] && (( depth == 0 )); then
                parts+=( "$current" )
                current=""
            else
                current+="$ch"
            fi
        done
        parts+=( "$current" )

        if (( ${#parts[@]} <= 1 )); then
            print -r -- "$s"
            return
        fi

        for p in "${parts[@]}"; do
            while IFS= read -r expanded; do
                print -r -- "$expanded"
            done < <(_brace_expand "${prefix}${p}${suffix}")
        done
    }

    # Expand glob patterns safely without eval
    _expand_globs() {
        local expr="$1" cur_root="$2" base_dir="$3"
        local p expanded word
        local -a words matches

        expr="$(_strip_quotes "$expr")"
        words=( ${(z)expr} ) || return 2

        for word in "${words[@]}"; do
            p="$(_resolve_vars "$word" "$cur_root")" || return 2
            while IFS= read -r expanded; do
                # Make relative paths absolute relative to base_dir
                if [[ "$expanded" != /* && "$expanded" != ~* ]]; then
                    expanded="$base_dir/$expanded"
                fi

                # Expand with null glob (N)
                if [[ "$expanded" == *'('*')'* ]]; then
                    matches=( ${~expanded} )
                else
                    matches=( ${~expanded}(N) )
                fi
                if (( ${#matches[@]} )); then
                    for m in "${matches[@]}"; do
                        if [[ -d "$m" ]]; then
                            for sub in "$m"/*.zsh(N); do
                                [[ -f "$sub" ]] && print -r -- "$sub"
                            done
                        elif [[ -f "$m" ]]; then
                            print -r -- "$m"
                        fi
                    done
                else
                    # Literal non-glob word
                    if [[ "$expanded" != *[\*\?\[\]]* && -f "$expanded" ]]; then
                        print -r -- "$expanded"
                    fi
                fi
            done < <(_brace_expand "$p")
        done
    }

    _in_stack() {
        local wanted="$1" x
        for x in "${STACK[@]}"; do
            [[ "$x" == "$wanted" ]] && return 0
        done
        return 1
    }

    # Check if a line is a fast-path loader guard that should be stripped
    _is_loader_guard() {
        local line="$1" out_dest="$2"
        # Match pattern: [[ -f ... ]] && source ... && return
        if [[ "$line" =~ '^[[:space:]]*\[\[[[:space:]]+-[fd][[:space:]]+.+\]\][[:space:]]*&&[[:space:]]*(source|\.)[[:space:]]+.+&&[[:space:]]*return' ]]; then
            return 0
        fi
        # Match explicit bundle loader
        if [[ "$line" =~ 'bundle/\.z' ]]; then
            return 0
        fi
        if [[ -n "$out_dest" && "$line" =~ "${out_dest:t}" && "$line" =~ 'return' ]]; then
            return 0
        fi
        return 1
    }

    # -------------------------------------------------------------------------
    # Core Transpiler
    # -------------------------------------------------------------------------

    _transpile_file() {
        local src="$1" dest="$2" cur_root="$3" out_dest="$4"
        local canonical="${src:A}"
        local src_dir="${canonical:h}"

        [[ -f "$canonical" ]] || return 0

        # Cycle detection
        if _in_stack "$canonical"; then
            _warn "circular dependency detected on $canonical (skipping)"
            return 0
        fi

        STACK+=( "$canonical" )

        local rel_path="${canonical#$cur_root/}"
        TRANSCRIPT_MANIFEST+=( "$rel_path" )

        print -r -- "" >> "$dest"
        print -r -- "# >>> [Transpiled: $rel_path] >>>" >> "$dest"

        local in_for_loop=false
        local -a for_files=()
        local -a for_body=()
        local -a candidate_files=()
        local -a valid_files=()
        local for_var="" for_header="" candidate_var="" candidate_expr="" bline="" f=""
        local fname="" fstem="" fallback_file="" raw="" is_source_loop=false
        local in_dynamic_if=false
        local in_else=false
        local dyn_var=""
        local dyn_dir=""
        local dyn_fallback=""
        local line="" raw_target="" resolved="" target_canonical=""
        local cond_target="" dir_expr=""

        while IFS= read -r line || [[ -n "$line" ]]; do
            # 0. Strip bundle fast-path loaders
            if _is_loader_guard "$line" "$out_dest"; then
                continue
            fi

            # 1. Generalized dynamic branch detection:
            # Matches: if [[ -f <dir>/${VAR}.zsh ]]; then
            #          if [[ -f "<dir>/${VAR}.zsh" ]]; then
            #          if [[ -f <dir>/"$VAR.zsh" ]]; then
            if [[ "$line" =~ '^[[:space:]]*if[[:space:]]+(\[\[|[[:space:]]*-f)[[:space:]]+-f[[:space:]]+(.+);[[:space:]]*then' ]] || \
               [[ "$line" =~ '^[[:space:]]*if[[:space:]]+(\[\[|[[:space:]]*-f)[[:space:]]+-f[[:space:]]+(.+)[[:space:]]*\]\][[:space:]]*;?[[:space:]]*then' ]]; then
                cond_target="${match[2]}"
                cond_target="${cond_target%\]\]*}"
                cond_target="$(_strip_quotes "$cond_target")"

                if [[ "$cond_target" =~ '[\"'\''/]?\$\{?([A-Za-z_][A-Za-z0-9_]*)\}?\.zsh[\"'\''/]?' ]]; then
                    dyn_var="${match[1]}"
                    dir_expr="${cond_target%/*}"
                    dir_expr="$(_resolve_vars "$dir_expr" "$cur_root")"
                    [[ "$dir_expr" == /* ]] || dir_expr="$src_dir/$dir_expr"
                    dyn_dir="${dir_expr:A}"
                    dyn_fallback=""
                    in_dynamic_if=true
                    in_else=false
                    continue
                fi
            fi

            # Inside dynamic if block: intercept fallback and synthesize case on 'fi'
            if [[ "$in_dynamic_if" == "true" ]]; then
                if [[ "$line" =~ '^[[:space:]]*else[[:space:]]*$' ]]; then
                    in_else=true
                    continue
                fi

                if [[ "$in_else" == "true" ]]; then
                    if [[ "$line" =~ '^[[:space:]]*(source|\.)[[:space:]]+(.+)$' ]]; then
                        raw="${match[2]}"
                        raw="${raw%%[[:space:]][#]*}"
                        raw="$(_strip_quotes "$raw")"
                        raw="$(_resolve_vars "$raw" "$cur_root")"
                        [[ "$raw" == /* ]] || raw="$src_dir/$raw"
                        dyn_fallback="${raw:A}"
                        continue
                    fi
                fi

                if [[ "$line" =~ '^[[:space:]]*fi[[:space:]]*$' ]]; then
                    in_dynamic_if=false
                    in_else=false
                    printf 'case "$%s" in\n' "$dyn_var" >> "$dest"

                    # Discover all profile files matching in the dynamic directory
                    if [[ -d "$dyn_dir" ]]; then
                        for f in "$dyn_dir"/*.zsh(N); do
                            fname="${f:t}"
                            fstem="${fname%.zsh}"
                            if [[ "${f:A}" != "$dyn_fallback" && "$fname" != "default.zsh" ]]; then
                                printf '    %s)\n' "$fstem" >> "$dest"
                                _transpile_file "$f" "$dest" "$cur_root" "$out_dest"
                                printf '        ;;\n' >> "$dest"
                            fi
                        done
                    fi

                    # Synthesize fallback / default under *)
                    fallback_file=""
                    if [[ -n "$dyn_fallback" && -f "$dyn_fallback" ]]; then
                        fallback_file="$dyn_fallback"
                    elif [[ -d "$dyn_dir" && -f "$dyn_dir/default.zsh" ]]; then
                        fallback_file="$dyn_dir/default.zsh"
                    fi

                    if [[ -n "$fallback_file" ]]; then
                        printf '    *)\n' >> "$dest"
                        _transpile_file "$fallback_file" "$dest" "$cur_root" "$out_dest"
                        printf '        ;;\n' >> "$dest"
                    fi

                    printf 'esac\n' >> "$dest"
                    continue
                fi
                continue
            fi

            # 2. Detect for loops that source files
            if [[ "$line" =~ '^[[:space:]]*for[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)[[:space:]]+in[[:space:]]+(.+);[[:space:]]*do' ]] || \
               [[ "$line" =~ '^[[:space:]]*for[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)[[:space:]]+in[[:space:]]+(.+)[[:space:]]*$' ]]; then
                candidate_var="${match[1]}"
                candidate_expr="${match[2]}"
                candidate_expr="${candidate_expr%;[[:space:]]*do}"
                candidate_expr="${candidate_expr%;}"

                # Only candidate if expression contains glob characters (* or ?) or references .zsh
                if [[ "$candidate_expr" == *[\*\?]* || "$candidate_expr" == *.zsh* ]]; then
                    candidate_files=( ${(f)"$(_expand_globs "$candidate_expr" "$cur_root" "$src_dir")"} )
                    candidate_files=( ${candidate_files:#} )
                    valid_files=()
                    for f in "${candidate_files[@]}"; do
                        [[ -f "$f" ]] && valid_files+=( "$f" )
                    done
                    if (( ${#valid_files[@]} )); then
                        in_for_loop=true
                        for_var="$candidate_var"
                        for_files=( "${valid_files[@]}" )
                        for_header="$line"
                        for_body=()
                        continue
                    fi
                fi
            fi

            if [[ "$in_for_loop" == "true" ]]; then
                if [[ "$line" =~ '^[[:space:]]*done[[:space:]]*$' ]]; then
                    in_for_loop=false
                    # Verify if loop body actually sources the loop variable
                    is_source_loop=false
                    for bline in "${for_body[@]}"; do
                        if [[ "$bline" =~ '(source|\.)[[:space:]]+' ]] && \
                           [[ "$bline" == *"\$$for_var"* || "$bline" == *"\${$for_var}"* ]]; then
                            is_source_loop=true
                            break
                        fi
                    done

                    if [[ "$is_source_loop" == "true" ]]; then
                        for f in "${for_files[@]}"; do
                            if [[ -f "$f" ]]; then
                                _transpile_file "$f" "$dest" "$cur_root" "$out_dest"
                            fi
                        done
                    else
                        # Not a sourcing loop -> preserve verbatim!
                        print -r -- "$for_header" >> "$dest"
                        for bline in "${for_body[@]}"; do
                            print -r -- "$bline" >> "$dest"
                        done
                        print -r -- "$line" >> "$dest"
                    fi
                    for_files=()
                    for_body=()
                    continue
                else
                    for_body+=( "$line" )
                    continue
                fi
            fi

            # 3. Detect direct source commands
            if [[ "$line" =~ '^[[:space:]]*(\[\[[[:space:]]+-f[[:space:]]+.+\]\][[:space:]]*&&[[:space:]]*)?(source|\.)[[:space:]]+(.+)$' ]]; then
                raw_target="${match[3]}"
                raw_target="${raw_target%%[[:space:]][#]*}"
                raw_target="$(_strip_quotes "$raw_target")"
                resolved="$(_resolve_vars "$raw_target" "$cur_root")"
                if [[ $? -eq 0 && -n "$resolved" ]]; then
                    [[ "$resolved" == /* ]] || resolved="$src_dir/$resolved"
                    target_canonical="${resolved:A}"
                    # Inline if internal within the root boundary and exists
                    if [[ "$target_canonical" == "$cur_root"/* && -f "$target_canonical" ]]; then
                        _transpile_file "$target_canonical" "$dest" "$cur_root" "$out_dest"
                        continue
                    fi
                fi
            fi

            # 4. Standard lines are preserved as-is
            print -r -- "$line" >> "$dest"
        done < "$canonical"

        print -r -- "" >> "$dest"
        print -r -- "# <<< [End: $rel_path] <<<" >> "$dest"

        STACK[-1]=()
        return 0
    }

    # -------------------------------------------------------------------------
    # Bundle Single File Function
    # -------------------------------------------------------------------------

    _bundle_single() {
        local in_file="$1" out_file="$2" cur_root="$3"
        local timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
        local base_name="${in_file:t}"

        [[ -f "$in_file" ]] || {
            _error "input file does not exist: $in_file"
            return 1
        }

        in_file="${in_file:A}"
        [[ -n "$cur_root" ]] || cur_root="$(_detect_root "$in_file")"
        [[ -n "$out_file" ]] || out_file="${in_file}.bundle"
        [[ "$out_file" == /* ]] || out_file="${PWD:A}/$out_file"

        mkdir -p "${out_file:h}" || {
            _error "cannot create output directory: ${out_file:h}"
            return 1
        }

        local temp_body="$(mktemp)"
        local temp_out="${out_file}.tmp.$$.$RANDOM"

        TRANSCRIPT_MANIFEST=()
        STACK=()
        LOOP_VARS=()

        (( opt_verbose )) && print -- "==> Bundling: $in_file (Root: $cur_root)"

        _transpile_file "$in_file" "$temp_body" "$cur_root" "$out_file"
        local rc=$?
        if (( rc != 0 )); then
            rm -f "$temp_body" "$temp_out"
            return $rc
        fi

        # Write header
        cat <<HEADER > "$temp_out"
# ==============================================================================
# BUNDLED ${base_name}
# Transpiled dynamically on $timestamp.
# Root: $cur_root
# ==============================================================================
HEADER

        if (( ${#TRANSCRIPT_MANIFEST[@]} > 0 )); then
            typeset -U uniq_manifest
            uniq_manifest=( "${TRANSCRIPT_MANIFEST[@]}" )
            print -r -- "# --- TRANSCRIPT: Inlined Files in Load Order (${#uniq_manifest[@]} files) ---" >> "$temp_out"
            local idx=1
            for f in "${uniq_manifest[@]}"; do
                printf "#   [%02d] %s\n" "$idx" "$f" >> "$temp_out"
                ((idx++))
            done
            print -r -- "# ==============================================================================" >> "$temp_out"
        fi

        cat "$temp_body" >> "$temp_out"
        rm -f "$temp_body"

        # Syntax check via zsh -n
        if ! zsh -n "$temp_out"; then
            _error "syntax validation failed for generated bundle: $out_file"
            rm -f "$temp_out"
            return 1
        fi

        chmod --reference="$in_file" "$temp_out" 2>/dev/null || chmod 600 "$temp_out"
        mv -f "$temp_out" "$out_file" || {
            _error "failed to install bundle: $out_file"
            rm -f "$temp_out"
            return 1
        }

        if (( opt_compile )); then
            zcompile "$out_file" || _warn "zcompile failed for $out_file"
        fi

        print -- "  -> Bundled: ${in_file} => ${out_file}"
        return 0
    }

    # -------------------------------------------------------------------------
    # Mode Dispatcher
    # -------------------------------------------------------------------------

    local effective_root="$opt_root"

    # Case A: Dotfile Suite Mode
    # Triggered when no positional arguments are given, OR when exactly 1 argument is given
    # that is a directory / bundle target (preserving bundle_and_compile backward compatibility).
    local run_suite=0
    local suite_target=""

    if (( ${#positional[@]} == 0 )); then
        run_suite=1
        suite_target="$opt_out"
    elif (( ${#positional[@]} == 1 )); then
        local p1="${positional[1]}"
        if [[ -d "$p1" || ( "$p1" != *.zsh && ! -f "$p1" ) ]]; then
            run_suite=1
            suite_target="$p1"
        fi
    fi

    if (( run_suite )); then
        local src_dir="${effective_root:-${ZDOTDIR:-$HOME/.config/zsh}}"
        local tgt_dir="${suite_target:-${src_dir}/bundle}"
        [[ -n "$effective_root" ]] || effective_root="$src_dir"

        mkdir -p "$tgt_dir" || {
            _error "failed to create bundle directory: $tgt_dir"
            return 1
        }

        echo "==> Transpiling top-level dotfiles from '$src_dir' to '$tgt_dir'..."
        local dotname
        for dotname in .zshenv .zprofile .zshrc .zlogin .zlogout; do
            local dotfile="$src_dir/$dotname"
            [[ -f "$dotfile" ]] || continue
            _bundle_single "$dotfile" "$tgt_dir/$dotname" "$effective_root" || return 1
        done

        if (( opt_compile )); then
            echo "==> Compiling bundled dotfiles with zcompile..."
            for f in "$tgt_dir"/.z*~*.zwc(N.) "$tgt_dir"/*.zsh~*.zwc(N.); do
                zcompile "$f" && echo "  Compiled: ${f:t}.zwc"
            done
        fi

        echo "==> Transpilation completed successfully!"
        return 0
    fi

    # Case B: Explicit file(s) passed via "$@"
    # If 2 positional arguments are passed, and first is an existing file, treat as input & output
    if [[ ${#positional[@]} -eq 2 && -f "${positional[1]}" && ! -d "${positional[2]}" ]]; then
        _bundle_single "${positional[1]}" "${positional[2]}" "$effective_root"
        return $?
    fi

    # Multi-file or single-file with optional --output directory
    local input_f out_f
    for input_f in "${positional[@]}"; do
        if [[ -n "$opt_out" && -d "$opt_out" ]]; then
            out_f="$opt_out/${input_f:t}"
        elif [[ -n "$opt_out" && ${#positional[@]} == 1 ]]; then
            out_f="$opt_out"
        else
            out_f="${input_f}.bundle"
        fi
        _bundle_single "$input_f" "$out_f" "$effective_root" || return 1
    done

    return 0
}