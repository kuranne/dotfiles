bundle_zdotfile() {
    local target_dir="${1:-${ZDOTDIR:-$HOME/.config/zsh}/bundle}"
    local source_dir="${ZDOTDIR:-$HOME/.config/zsh}"
    local timestamp="$(date '+%Y-%m-%d %H:%M:%S')"

    mkdir -p "$target_dir" || {
        echo >&2 "Error: Failed to create bundle directory: $target_dir"
        return 1
    }

    echo "==> Bundling Zsh configurations from '$source_dir' to '$target_dir'..."

    # Helper function to append a section with clean newlines and demarcation banners
    _bundle_append() {
        local src="$1"
        local dest="$2"
        local label="$3"
        local strip_conf_sources="${4:-false}"

        [[ ! -f "$src" ]] && return 0

        print -r -- "" >> "$dest"
        print -r -- "# >>> [${label}] ${src:t} >>>" >> "$dest"

        local in_conf_loop=false
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ "$strip_conf_sources" == "true" ]]; then
                if [[ "$line" =~ '^[[:space:]]*for[[:space:]]+[a-zA-Z_][a-zA-Z0-9_]*[[:space:]]+in[[:space:]]+.*conf\.d/' ]]; then
                    in_conf_loop=true
                    print -r -- "# [inlined] $line" >> "$dest"
                    continue
                fi
                if [[ "$in_conf_loop" == "true" ]]; then
                    print -r -- "# [inlined] $line" >> "$dest"
                    if [[ "$line" =~ '^[[:space:]]*done[[:space:]]*$' ]]; then
                        in_conf_loop=false
                    fi
                    continue
                fi
                if [[ "$line" =~ 'source[[:space:]]+.*conf\.d/' ]]; then
                    print -r -- "# [inlined] $line" >> "$dest"
                    continue
                fi
            fi
            print -r -- "$line" >> "$dest"
        done < "$src"

        print -r -- "" >> "$dest"
        print -r -- "# <<< [${label}] ${src:t} <<<" >> "$dest"
    }

    # ==============================================================================
    # 1. BUNDLE .zshenv
    # ==============================================================================
    local zshenv_out="$target_dir/.zshenv"
    cat <<EOF > "$zshenv_out"
# ==============================================================================
# BUNDLED ENVIRONMENT VARIABLES (.zshenv)
# Auto-generated by bundle_zdotfile on $timestamp.
# Do not edit this file directly; edit modular files in conf.d/ instead.
# ==============================================================================
EOF

    # Append base .zshenv without the final dynamic loader block
    if [[ -f "$source_dir/.zshenv" ]]; then
        print -r -- "" >> "$zshenv_out"
        print -r -- "# >>> Base .zshenv >>>" >> "$zshenv_out"
        local in_loader_block=false
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ "$line" =~ '^[[:space:]]*if[[:space:]]+\[\[[[:space:]]+-f[[:space:]]+"\$\{ZDOTDIR\}/conf\.d/zshenv/' ]]; then
                in_loader_block=true
            fi
            if [[ "$in_loader_block" == "false" ]]; then
                print -r -- "$line" >> "$zshenv_out"
            fi
            if [[ "$in_loader_block" == "true" && "$line" =~ '^[[:space:]]*fi[[:space:]]*$' ]]; then
                in_loader_block=false
            fi
        done < "$source_dir/.zshenv"
        print -r -- "# <<< Base .zshenv <<<" >> "$zshenv_out"
    fi

    # Append conf.d/zshenv/ (and paths.zsh)
    print -r -- "" >> "$zshenv_out"
    print -r -- "# >>> Environment Paths (conf.d/zshenv) >>>" >> "$zshenv_out"
    if [[ -f "$source_dir/conf.d/env/paths.zsh" ]]; then
        _bundle_append "$source_dir/conf.d/env/paths.zsh" "$zshenv_out" "conf.d/env/paths.zsh"
    fi
    # Check for any terminal-specific zshenv configs
    for f in "$source_dir"/conf.d/zshenv/*.zsh(N); do
        if [[ "${f:t}" != "default.zsh" ]]; then
            local term_name="${${f:t}%.zsh}"
            print -r -- "if [[ \"\$MY_TERM\" == \"$term_name\" ]]; then" >> "$zshenv_out"
            _bundle_append "$f" "$zshenv_out" "conf.d/zshenv/${f:t}" true
            print -r -- "fi" >> "$zshenv_out"
        fi
    done
    print -r -- "# <<< Environment Paths (conf.d/zshenv) <<<" >> "$zshenv_out"

    # ==============================================================================
    # 2. BUNDLE .zprofile
    # ==============================================================================
    local zprofile_out="$target_dir/.zprofile"
    cat <<EOF > "$zprofile_out"
# ==============================================================================
# BUNDLED LOGIN SHELL CONFIGURATION (.zprofile)
# Auto-generated by bundle_zdotfile on $timestamp.
# Do not edit this file directly; edit modular files in conf.d/ instead.
# ==============================================================================
EOF

    print -r -- "" >> "$zprofile_out"
    print -r -- 'case "$MY_TERM" in' >> "$zprofile_out"
    # Terminal-specific zprofile files
    for f in "$source_dir"/conf.d/zprofile/*.zsh(N); do
        if [[ "${f:t}" != "default.zsh" ]]; then
            local term_name="${${f:t}%.zsh}"
            print -r -- "    ${term_name})" >> "$zprofile_out"
            _bundle_append "$f" "$zprofile_out" "conf.d/zprofile/${f:t}" true
            print -r -- "        ;;" >> "$zprofile_out"
        fi
    done
    # Default zprofile
    print -r -- '    *)' >> "$zprofile_out"
    if [[ -f "$source_dir/conf.d/zprofile/default.zsh" ]]; then
        _bundle_append "$source_dir/conf.d/zprofile/default.zsh" "$zprofile_out" "conf.d/zprofile/default.zsh" true
    fi
    print -r -- "        ;;" >> "$zprofile_out"
    print -r -- "esac" >> "$zprofile_out"

    # ==============================================================================
    # 3. BUNDLE .zshrc
    # ==============================================================================
    local zshrc_out="$target_dir/.zshrc"
    cat <<EOF > "$zshrc_out"
# ==============================================================================
# BUNDLED INTERACTIVE SHELL CONFIGURATION (.zshrc)
# Auto-generated by bundle_zdotfile on $timestamp.
# Do not edit this file directly; edit modular files in conf.d/ instead.
# ==============================================================================
EOF

    # Apple Terminal branch: minimal security / no bloat
    print -r -- 'if [[ "$MY_TERM" == "Apple_Terminal" ]]; then' >> "$zshrc_out"
    print -r -- '    # Minimal, raw environment for Apple Terminal' >> "$zshrc_out"
    _bundle_append "$source_dir/conf.d/env/history.zsh" "$zshrc_out" "Apple_Terminal: history env"
    _bundle_append "$source_dir/conf.d/option/history.zsh" "$zshrc_out" "Apple_Terminal: history option"
    _bundle_append "$source_dir/conf.d/env/paths.zsh" "$zshrc_out" "Apple_Terminal: paths"
    print -r -- 'else' >> "$zshrc_out"

    # Full environment:
    # 3.1 Options
    print -r -- "" >> "$zshrc_out"
    print -r -- "    # --- 1. Shell Options (conf.d/option) ---" >> "$zshrc_out"
    for f in "$source_dir"/conf.d/option/*.zsh(N); do
        _bundle_append "$f" "$zshrc_out" "conf.d/option/${f:t}"
    done

    # 3.2 Environment
    print -r -- "" >> "$zshrc_out"
    print -r -- "    # --- 2. Environment Variables & Paths (conf.d/env) ---" >> "$zshrc_out"
    for f in "$source_dir"/conf.d/env/*.zsh(N); do
        _bundle_append "$f" "$zshrc_out" "conf.d/env/${f:t}"
    done

    # 3.3 Keybinds
    print -r -- "" >> "$zshrc_out"
    print -r -- "    # --- 3. Keybindings (conf.d/keybind) ---" >> "$zshrc_out"
    for f in "$source_dir"/conf.d/keybind/*.zsh(N); do
        _bundle_append "$f" "$zshrc_out" "conf.d/keybind/${f:t}"
    done

    # 3.4 Plugins
    print -r -- "" >> "$zshrc_out"
    print -r -- "    # --- 4. Plugins (conf.d/zshrc/plugins) ---" >> "$zshrc_out"
    for f in "$source_dir"/conf.d/zshrc/plugins/*.zsh(N); do
        _bundle_append "$f" "$zshrc_out" "conf.d/zshrc/plugins/${f:t}"
    done

    # 3.5 Integrations (including evalcache CLI scripts)
    print -r -- "" >> "$zshrc_out"
    print -r -- "    # --- 5. Integrations (conf.d/zshrc/integrations) ---" >> "$zshrc_out"
    for f in "$source_dir"/conf.d/zshrc/integrations/*.zsh(N); do
        _bundle_append "$f" "$zshrc_out" "conf.d/zshrc/integrations/${f:t}" true
    done
    for f in "$source_dir"/conf.d/zshrc/integrations/evalcache/*.zsh(N); do
        _bundle_append "$f" "$zshrc_out" "conf.d/zshrc/integrations/evalcache/${f:t}"
    done

    # 3.6 Bindings (binding.zsh, fzf.zsh)
    print -r -- "" >> "$zshrc_out"
    print -r -- "    # --- 6. Bindings & Widgets (conf.d/zshrc/bindings) ---" >> "$zshrc_out"
    for f in "$source_dir"/conf.d/zshrc/bindings/*.zsh(N); do
        _bundle_append "$f" "$zshrc_out" "conf.d/zshrc/bindings/${f:t}" true
    done

    # 3.7 Aliases
    print -r -- "" >> "$zshrc_out"
    print -r -- "    # --- 7. Aliases (conf.d/zshrc/aliases) ---" >> "$zshrc_out"
    for f in "$source_dir"/conf.d/zshrc/aliases/*.zsh(N); do
        _bundle_append "$f" "$zshrc_out" "conf.d/zshrc/aliases/${f:t}"
    done

    # 3.8 Functions
    print -r -- "" >> "$zshrc_out"
    print -r -- "    # --- 8. Custom Functions (conf.d/zshrc/functions) ---" >> "$zshrc_out"
    for f in "$source_dir"/conf.d/zshrc/functions/*.zsh(N); do
        _bundle_append "$f" "$zshrc_out" "conf.d/zshrc/functions/${f:t}"
    done

    # 3.9 Terminal-specific zshrc configurations
    print -r -- "" >> "$zshrc_out"
    print -r -- "    # --- 9. Terminal Specific Configurations ---" >> "$zshrc_out"
    print -r -- '    case "$MY_TERM" in' >> "$zshrc_out"
    # Scan for terminal directories under conf.d/zshrc/
    for d in "$source_dir"/conf.d/zshrc/*(/N); do
        local dname="${d:t}"
        if [[ "$dname" != "plugins" && "$dname" != "integrations" && "$dname" != "aliases" && "$dname" != "bindings" && "$dname" != "functions" ]]; then
            print -r -- "        ${dname})" >> "$zshrc_out"
            # If there is a <term>.zsh in conf.d/zshrc/, append it with conf.d sources stripped
            if [[ -f "$source_dir/conf.d/zshrc/${dname}.zsh" ]]; then
                _bundle_append "$source_dir/conf.d/zshrc/${dname}.zsh" "$zshrc_out" "conf.d/zshrc/${dname}.zsh" true
            fi
            # Append all files in the terminal folder
            for f in "$d"/*.zsh(N); do
                _bundle_append "$f" "$zshrc_out" "conf.d/zshrc/${dname}/${f:t}"
            done
            print -r -- "            ;;" >> "$zshrc_out"
        fi
    done
    print -r -- "    esac" >> "$zshrc_out"
    print -r -- 'fi' >> "$zshrc_out"

    # ==============================================================================
    # 4. BUNDLE .zlogin
    # ==============================================================================
    local zlogin_out="$target_dir/.zlogin"
    cat <<EOF > "$zlogin_out"
# ==============================================================================
# BUNDLED LOGIN NOTIFICATIONS (.zlogin)
# Auto-generated by bundle_zdotfile on $timestamp.
# Do not edit this file directly; edit modular files in conf.d/ instead.
# ==============================================================================
EOF

    print -r -- "" >> "$zlogin_out"
    print -r -- 'case "$MY_TERM" in' >> "$zlogin_out"
    for f in "$source_dir"/conf.d/zlogin/*.zsh(N); do
        local term_name="${${f:t}%.zsh}"
        print -r -- "    ${term_name})" >> "$zlogin_out"
        _bundle_append "$f" "$zlogin_out" "conf.d/zlogin/${f:t}"
        print -r -- "        ;;" >> "$zlogin_out"
    done
    print -r -- "esac" >> "$zlogin_out"

    # ==============================================================================
    # 5. BUNDLE .zlogout
    # ==============================================================================
    local zlogout_out="$target_dir/.zlogout"
    cat <<EOF > "$zlogout_out"
# ==============================================================================
# BUNDLED LOGOUT ACTIONS (.zlogout)
# Auto-generated by bundle_zdotfile on $timestamp.
# Do not edit this file directly; edit modular files in conf.d/ instead.
# ==============================================================================
EOF

    for f in "$source_dir"/conf.d/zlogout/*.zsh(N); do
        _bundle_append "$f" "$zlogout_out" "conf.d/zlogout/${f:t}"
    done

    echo "==> Bundling completed successfully!"
    echo "    Generated files in $target_dir:"
    echo "    - .zshenv"
    echo "    - .zprofile"
    echo "    - .zshrc"
    echo "    - .zlogin"
    echo "    - .zlogout"
}

bundle_zdotfile "$@"
