copy-command() {
    [[ -z "$BUFFER" ]] && return

    if [[ -n "$ZSH_CLIPBOARD_CMD" ]]; then
        eval "print -rn -- \"\$BUFFER\" | $ZSH_CLIPBOARD_CMD"
        zle -M "Copied current command to clipboard!"
    else
        zle -M "Error: No clipboard tool found (install pbcopy/xclip/wl-copy)"
        return 1
    fi
}
